# Normalize line endings in the repository so checkouts are identical on every
# platform, regardless of each developer's local core.autocrlf setting.

# Let Git detect text files and store them with LF in the repository.
* text=auto

# Source and config: LF everywhere, including on Windows checkouts.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows-native scripts need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Copy this file to `.env` and fill in local values. `.env` is git-ignored.
# Never put real API keys, passwords, or personal data in this example file.

# --- Core (Phase 1) ---
GAMEJOB_SCOUT_DATABASE_URL=sqlite:///./data/gamejob_scout.db
GAMEJOB_SCOUT_LOG_LEVEL=INFO

# Polite crawling defaults. Identify the tool honestly in the User-Agent.
GAMEJOB_SCOUT_HTTP_TIMEOUT_SECONDS=20
GAMEJOB_SCOUT_HTTP_MAX_RETRIES=3
GAMEJOB_SCOUT_HTTP_REQUESTS_PER_SECOND=1
GAMEJOB_SCOUT_USER_AGENT="gamejob-scout/0.1 (+https://github.com/ege-ozgur/gamejob-scout)"

# --- LLM matching (Phase 2; leave empty until that phase) ---
GAMEJOB_SCOUT_LLM_PROVIDER=
GAMEJOB_SCOUT_LLM_MODEL=
GAMEJOB_SCOUT_LLM_API_KEY=

# --- Email digest (Phase 4; stays disabled until explicitly turned on) ---
GAMEJOB_SCOUT_EMAIL_ENABLED=false
GAMEJOB_SCOUT_EMAIL_FROM=
GAMEJOB_SCOUT_EMAIL_TO=
GAMEJOB_SCOUT_SMTP_HOST=
GAMEJOB_SCOUT_SMTP_PORT=587
GAMEJOB_SCOUT_SMTP_USERNAME=
GAMEJOB_SCOUT_SMTP_PASSWORD=
